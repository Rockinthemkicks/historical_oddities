# Copy this file to .env and fill in your keys. Never commit .env.

OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
# Required: your narrator's ElevenLabs voice ID. There is no fallback voice.
ELEVENLABS_VOICE_ID=g14YnDYCsy3k7XLlcKlO   # "Todd", the channel narrator
# Optional: your plan's real cost per 1,000 characters, so budgets are accurate.
# Defaults to a conservative 0.30 if unset.
# ELEVENLABS_USD_PER_1K_CHARS=0.30
